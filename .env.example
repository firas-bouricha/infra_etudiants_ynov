# Copier ce fichier en ".env" puis remplir les valeurs :
#   cp .env.example .env
# Charger les variables avant chaque session de travail :
#   source .env
# Le fichier .env ne doit JAMAIS être publié (il est dans .gitignore).

# Adresse de l'API Proxmox (garder le https et le port 8006)
export TF_VAR_proxmox_endpoint="https://192.168.137.129:8006/"

# Jeton API créé sur Proxmox (voir README, étape 1)
export TF_VAR_proxmox_api_token="terraform@pve!tf=COLLER-LE-SECRET-ICI"

# Mot de passe initial donné à tous les étudiants (à changer à la première connexion)
export TF_VAR_student_password="ChangeMoi-2026!"

# Nom du noeud Proxmox, seulement si différent de "pve"
# export TF_VAR_node_name="pve"
